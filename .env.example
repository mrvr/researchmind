# ResearchMind — environment variables template.
# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real keys. See documents/similarity-finder-architecture.md
# for what each Similarity Finder source is used for.

# ── Ollama (optional — defaults shown) ──────────────────────────────────────
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=mistral

# ── Whisper (optional — auto-selected from GPU/VRAM if unset) ──────────────
# WHISPER_MODEL=medium

# ── Similarity Finder — active connectors ───────────────────────────────────
# IEEE Xplore API — free developer key: https://developer.ieee.org/
IEEE_API_KEY=

# NASA ADS API (AAS journals: ApJ, AJ, ApJL) — free token:
# https://ui.adsabs.harvard.edu/user/settings/token
ADS_API_TOKEN=

# Semantic Scholar — optional, works keyless; a key just raises the rate
# limit. Request one at: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# ── Similarity Finder — placeholder sources (not yet wired up) ─────────────
# These map to config.EXTRA_SEARCH_SOURCES entries. Setting a key here does
# nothing until a matching connectors/<key>_connector.py exists and
# "enabled" is flipped to True for that source — see
# connectors/_template_connector.py.
CORE_API_KEY=
SPRINGER_API_KEY=
ELSEVIER_API_KEY=
